# =============================================================================
# kid-main 环境变量示例（P0/T0 收尾产物）
# -----------------------------------------------------------------------------
# 用法：
#   本文件仅作「模板/文档」。实际生效需让 api_server 进程的环境里存在这些变量。
#   三种注入方式（任选其一，按部署形态）：
#     1) 宝塔 + Supervisor：在 Supervisor 的 environment= 段写入（推荐）
#     2) Docker：写进 docker-compose.yml 的 environment: 段
#     3) 直接运行：在启动脚本里 `export` 后 `python api_server.py`
#   ⚠️ 注意：api_server 仅从「进程环境」读下方变量；.env.local 只被 _load_config
#     用于覆盖 LLM 的 api_key，不会自动加载本文件的路径变量。
# =============================================================================

# ── 站点/接口安全（P0-2）──
# 允许跨域的源，逗号分隔。生产环境务必只列本站域名，不要再写 *。
ALLOWED_ORIGINS=https://grow-consultant.com,https://www.grow-consultant.com

# ── 数据根目录（P1-3 / P2-1）──
# 所有 JSON 数据（chat_*.json / planner_*.json / errors_*.json 等）的存放目录。
# 迁阿里云宝塔时改为站点根下的 data 目录，例如 /www/wwwroot/<域名>/data
DATA_DIR=/var/www/plan/data

# ── 规划背景文档（P1-3）──
# 子目录或无后缀目录，内含 <Child>_Plan.md 与 Research_Intel.md。
# 默认 <DATA_DIR>/plan_context；若沿用旧开发机挂载，可指向 /mnt/d/MyAI
PLAN_MD_PATH=/var/www/plan/data/plan_context

# 外部情报 MD 的显式路径（覆盖上面的推算）。
# 留空则使用 <PLAN_MD_PATH>/Research_Intel.md
RESEARCH_INTEL_PATH=/var/www/plan/data/plan_context/Research_Intel.md

# Hermes（报告/配置）根目录（P1-3）。默认 ~/.hermes；服务器上若无此目录，相关功能静默降级。
HERMES_HOME=/root/.hermes

# ── 聊天上下文窗口（P1-4）──
# 每次调用 LLM 最多携带的最近对话条数。避免历史无限增长导致 token 超限/成本上升。
CHAT_MAX_HISTORY=20

# ── LLM Key（P0-1 暂缓：密钥外置未做，此处仅为后续预留；当前仍硬编码于 research_collector.py）──
# DEEPSEEK_API_KEY=
# TAVILY_API_KEY=
